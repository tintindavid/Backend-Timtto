{
  "name": "timttoapp",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/dev-runner.js",
    "dev:ts": "ts-node-dev --respawn --transpile-only --respawn-delay 200 src/server.ts",
    "dev:js": "nodemon --watch src --ext js,json --exec \"node --enable-source-maps src/server.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint \"src/**/*.{ts,js}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.8.0",
    "firebase": "^12.8.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "jszip": "^3.10.1",
    "mongoose": "^8.14.0",
    "mongoose-autopopulate": "^1.2.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nanoid": "^5.0.7",
    "qrcode": "^1.5.4",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^13.0.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^9.1.7",
    "nodemon": "^3.0.1",
    "prettier": "^3.3.3",
    "semantic-release": "^25.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.0"
  }
}
