# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/timtto

#mongodb+srv://Tinvaz:38jPEulx5UgDmOAV@biolab-sas.mxgmg.mongodb.net/Timtto?retryWrites=true&w=majority

#mongodb://localhost:27017/timtto

# Auth
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=7d

# Public auth (used by /public/tickets/* sessionToken).
# MUST be different from JWT_SECRET. Server refuses to start if they match.
JWT_PUBLIC_SECRET=replace_with_distinct_public_secret
JWT_PUBLIC_EXPIRES_IN=2h

# Optional: filesystem folder where QR PNGs are persisted at QR creation.
# Defaults to "uploads/qr" relative to the backend cwd.
QR_IMAGE_STORAGE_PATH=uploads/qr

# Optional: public base URL used to build the qrToken landing URL printed on PNGs
# (https://{PUBLIC_APP_BASE_URL}/public/ticket/{qrToken})
PUBLIC_APP_BASE_URL=http://localhost:5173

# CORS - comma separated allowed origins (include your frontend domains)
# For production, add your Vercel domain here
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://timtto.vercel.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Firebase Storage (para almacenar logos de clientes)
# Las credenciales están hardcodeadas en firebase.config.js
# No se requieren variables de entorno adicionales

#ruta pdf microservicio

PDF_SERVICE_URL=https://html-to-pdf-service-production-a1f8.up.railway.app/api/pdf
PDF_MICROSERVICE_TIMEOUT=30000

# Other
SENTRY_DSN=

# Tenant binding (spec: tenant-token-binding). Authenticated non-superadmin requests are bound to the
# tenant in their JWT; a different x-tenant-id is rejected with 403 FORBIDDEN_CROSS_TENANT.
# Emergency switch for local debugging or rollback ONLY (logs a warning per bypassed request).
# ENFORCE_TENANT_TOKEN_MATCH=off

# Tenant capabilities (spec: tenant-capabilities). Mutating requests of the execution flow (OT, reports,
# worksheets, client-portal tokens) are rejected with 403 CAPABILITY_DISABLED for tenants without
# executesServices. Read at request time. on (default) | warn (log the denial, allow the request) | off (bypass).
# Rollback: set it to off; the Tenant fields are additive.
# ENFORCE_TENANT_CAPABILITIES=on
