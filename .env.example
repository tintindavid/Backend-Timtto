# Server
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/timtto

# Auth
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=7d

# CORS - comma separated allowed origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Firebase Storage (para almacenar logos de clientes)
# Las credenciales están hardcodeadas en firebase.config.js
# No se requieren variables de entorno adicionales

#ruta pdf microservicio

PDF_SERVICE_URL=http://html-to-pdf-service.railway.internal/api/pdf
PDF_MICROSERVICE_TIMEOUT=30000

# Other
SENTRY_DSN=
